# Groq API Key (required) - get free key from https://console.groq.com
GROQ_API_KEY=gsk_paste_yours_here
GROQ_MODEL=qwen/qwen3.8-27b

# Database (optional) - if not set or unreachable, transparent local JSON fallback is used
# Local: mongodb://localhost:27017
# Free Cloud Atlas: mongodb+srv://<user>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017
MONGO_DB=chatpdfs

# RAG & Vector Search Configuration
RAG_TOP_K=5
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
EMBED_MODEL=all-MiniLM-L6-v2
